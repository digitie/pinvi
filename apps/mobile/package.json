{
  "name": "@pinvi/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Pinvi 모바일 앱 (Expo SDK 56 / Dev Client / RN New Architecture). Next.js 웹과 @pinvi/* 공용 패키지를 공유한다 (ADR-011 / ADR-041 / ADR-043). Sprint M-1 활성화됨(root workspaces 등록 + 설치). 절차는 README.md.",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-reanimated",
        "react-native-worklets",
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "build:development:android": "eas build --platform android --profile development",
    "build:development:ios": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform all --profile preview",
    "build:production": "eas build --platform all --profile production",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "^11.3.4",
    "@pinvi/api-client": "*",
    "@pinvi/design-tokens": "*",
    "@pinvi/domain": "*",
    "@pinvi/hooks": "*",
    "@pinvi/i18n": "*",
    "@pinvi/schemas": "*",
    "@pinvi/state": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~57.0.16",
    "expo-build-properties": "~57.0.14",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.15",
    "expo-linking": "~57.0.7",
    "expo-location": "~57.0.13",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.1.23",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.12.1",
    "vworld-map-core": "file:vendor/vworld-map-core-1.0.0.tgz",
    "vworld-map-rn": "file:vendor/vworld-map-rn-1.0.0.tgz",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-expo": "~57.0.2",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0"
  }
}
