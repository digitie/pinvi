{
  "name": "@pinvi/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev -p 12805",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "next build --webpack",
    "start": "next start -p 12805",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:admin-live": "playwright test -c playwright.admin-live.config.ts",
    "test:e2e:admin-live:list": "playwright test -c playwright.admin-live.config.ts --list",
    "test:e2e:live-mutating": "playwright test -c playwright.live-mutating.config.ts",
    "test:e2e:live-mutating:list": "playwright test -c playwright.live-mutating.config.ts --list",
    "test:e2e:live-catalog": "playwright test -c playwright.live-catalog.config.ts",
    "test:e2e:live-catalog:list": "playwright test -c playwright.live-catalog.config.ts --list",
    "test:e2e:live-catalog:index": "node e2e-live/catalog/build-index.mjs --check",
    "test:e2e:map": "playwright test map-shell.e2e.ts",
    "test:watch": "vitest",
    "check:dependencies": "node ../../node_modules/@kor-travel/ui/check-dependencies.mjs --lock ../../package-lock.json --workspace apps/web --artifacts common-artifacts.json --source \"app/(admin)\" --source components/admin && node scripts/check-common-ui.mjs",
    "doctor": "react-doctor . --yes --scope full --blocking warning --no-score --no-supply-chain --no-parallel --no-cache",
    "predoctor": "node ./scripts/copy-maplibre-worker.mjs",
    "check:maplibre-worker": "node ./scripts/copy-maplibre-worker.mjs --check"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.5",
    "@kor-travel/tokens": "file:vendor/kor-travel-tokens-0.1.1.tgz",
    "@kor-travel/ui": "file:vendor/kor-travel-ui-0.2.0.tgz",
    "@pinvi/api-client": "*",
    "@pinvi/design-tokens": "*",
    "@pinvi/domain": "*",
    "@pinvi/hooks": "*",
    "@pinvi/i18n": "*",
    "@pinvi/schemas": "*",
    "@pinvi/state": "*",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "maplibre-gl": "6.17.0",
    "next": "16.4.6",
    "next-intl": "4.15.0",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "tailwind-merge": "3.7.0",
    "vworld-map-core": "file:vendor/vworld-map-core-1.0.1.tgz",
    "vworld-map-web": "file:vendor/vworld-map-web-1.0.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "lightningcss": "file:vendor/lightningcss-1.33.0+nativecss.fix.3.tgz",
    "postcss": "8.5.32",
    "react-doctor": "0.9.22",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "reactDoctor": {
    "ignore": {
      "files": [
        "public/maplibre/maplibre-gl-worker.mjs",
        "public/maplibre/maplibre-gl-shared.mjs"
      ]
    }
  }
}
