{
  "name": "@pinvi/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Pinvi 모바일 앱 (Expo SDK 58 / Dev Client / RN New Architecture). Next.js 웹과 @pinvi/* 공용 패키지를 공유한다 (ADR-011 / ADR-041 / ADR-043). Sprint M-1 활성화됨(root workspaces 등록 + 설치). 절차는 README.md.",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-reanimated",
        "react-native-worklets",
        "typescript",
        "@react-native-async-storage/async-storage"
      ]
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "web": "expo start --web",
    "build:development:android": "eas build --platform android --profile development",
    "build:development:ios": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform all --profile preview",
    "build:production": "eas build --platform all --profile production",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "check:styling": "node ../../scripts/check-mobile-styling.mjs",
    "doctor": "react-doctor . --yes --scope full --blocking warning --no-score --no-supply-chain --no-parallel --no-cache",
    "test:e2e:web": "node ../../scripts/mobile-web-smoke.mjs",
    "check:dependencies": "node ../../node_modules/@kor-travel/tokens/check-dependencies.mjs --profile mobile --lock ../../package-lock.json --workspace apps/mobile --artifacts common-artifacts.json --source app --source components",
    "export:ios": "expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@kor-travel/tokens": "file:../web/vendor/kor-travel-tokens-0.1.1.tgz",
    "@maplibre/maplibre-react-native": "11.5.1",
    "@pinvi/api-client": "*",
    "@pinvi/design-tokens": "*",
    "@pinvi/domain": "*",
    "@pinvi/hooks": "*",
    "@pinvi/i18n": "*",
    "@pinvi/schemas": "*",
    "@pinvi/state": "*",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@tanstack/react-query": "5.107.1",
    "expo": "58.0.24",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.19",
    "expo-font": "58.0.12",
    "expo-linking": "58.0.17",
    "expo-location": "58.0.21",
    "expo-router": "58.0.31",
    "expo-secure-store": "58.0.3",
    "expo-status-bar": "58.0.5",
    "expo-web-browser": "58.0.8",
    "nativewind": "5.0.0-rc.1",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.1",
    "vworld-map-core": "file:../web/vendor/vworld-map-core-1.0.1.tgz",
    "vworld-map-rn": "file:../web/vendor/vworld-map-rn-1.0.1.tgz",
    "vworld-map-web": "file:../web/vendor/vworld-map-web-1.0.3.tgz",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "lightningcss": "file:../web/vendor/lightningcss-1.33.0+nativecss.fix.4.tgz",
    "postcss": "8.5.32",
    "react-doctor": "0.9.22",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
