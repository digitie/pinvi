# Pinvi 운영(prod) env 템플릿 — placeholder만. 실제 값은 `infra/.env.prod`(gitignore)에 둔다.
# 공개 repo에는 실제 도메인/시크릿을 커밋하지 않는다(ADR-047).
#
# 사용:
#   cp infra/.env.prod.example infra/.env.prod   # 후 실제 값으로 채움
#   PINVI_ENV_FILE=infra/.env.prod scripts/deploy-node.sh deploy
#   (또는 운영 노드 /opt/pinvi/.env 로 복사 — compose는 cwd의 .env를 자동 로드)

# canonical 값만 허용: development | test | smoke | staging | production
PINVI_ENVIRONMENT=production

# ── 도메인 (reverse proxy → 로컬 고정 포트) ──────────────────────────────
#   web      → :12805   |  api  → :12801  |  dagster → :12802
#   grafana  → :12205
#   s3 api   → RustFS API :12101 (presigned 서명 host)
#   s3 콘솔  → RustFS console :12105 (reverse proxy 전용, app env 아님)
PINVI_WEB_BASE_URL=https://pinvi.example.com
PINVI_DAGSTER_BASE_URL=https://dagster.example.com
# Google Cloud Console OAuth web client. 실제 값은 운영 secret source에서 주입한다.
PINVI_GOOGLE_OAUTH_CLIENT_ID=
PINVI_GOOGLE_OAUTH_CLIENT_SECRET=
PINVI_OAUTH_CALLBACK_BASE_URL=https://pinvi-api.example.com
PINVI_CORS_ALLOWED_ORIGINS=["https://pinvi.example.com"]
NEXT_PUBLIC_PINVI_API_URL=https://pinvi-api.example.com
NEXT_PUBLIC_PINVI_ENV=production
NEXT_PUBLIC_GRAFANA_URL=https://grafana.example.com
NEXT_PUBLIC_GRAFANA_DASHBOARD_PATH=/d/pinvi/overview?orgId=1&kiosk=tv
EXPO_PUBLIC_PINVI_API_URL=https://pinvi-api.example.com

# ── RustFS ───────────────────────────────────────────────────────────────
# 서버→RustFS 내부 endpoint는 compose 내부망(app-rustfs:9000) 유지.
# 브라우저 presigned 서명 host = public endpoint = s3 api 도메인.
PINVI_RUSTFS_PUBLIC_ENDPOINT_URL=https://s3-api.example.com
PINVI_RUSTFS_PUBLIC_BASE_URL=https://s3-api.example.com

# ── 관측/운영 ────────────────────────────────────────────────────────────
PINVI_SENTRY_ENVIRONMENT=production
PINVI_RATE_LIMIT_BACKEND=postgres
# kor-travel-map 사용자 API client. public key는 X-Kor-Travel-Map-Api-Key 헤더로만 전송하고,
# 실제 credential은 운영 secret source에서 주입한다.
PINVI_KOR_TRAVEL_MAP_API_BASE_URL=http://host.docker.internal:12701
PINVI_KOR_TRAVEL_MAP_SERVICE_TOKEN=
# new_place 승인 전용 Map service writer token. admin/public/ops/curation token과 재사용하지 않는다.
KOR_TRAVEL_MAP_FEATURE_REQUEST_TOKEN=
# public REST의 X-Kor-Travel-Map-Api-Key 헤더.
PINVI_KOR_TRAVEL_MAP_PUBLIC_API_KEY=
# kor-travel-map canonical admin ops. URL은 허용 host의 :12701 root만, 실제 token 두 값은
# 서로 달라야 하며 32자 이상이고 Unicode whitespace를 포함하면 안 된다.
PINVI_KOR_TRAVEL_MAP_ADMIN_BASE_URL=http://host.docker.internal:12701
PINVI_KOR_TRAVEL_MAP_OPS_READ_TOKEN=change-me-read-token-at-least-32-characters
PINVI_KOR_TRAVEL_MAP_OPS_CANCEL_TOKEN=change-me-cancel-token-at-least-32-characters
# source projection/outbox는 flag와 무관하게 기록한다. compatible pair 검증 전에는 false 유지.
PINVI_KOR_TRAVEL_MAP_CACHE_TARGET_SYNC_ENABLED=false
PINVI_KOR_TRAVEL_MAP_CACHE_TARGET_COMMAND_TOKEN=
PINVI_KOR_TRAVEL_MAP_CACHE_TARGET_CONSUMER_TOKEN=
PINVI_KOR_TRAVEL_MAP_CACHE_TARGET_CONSUMER_ID=pinvi-cache-target-consumer
PINVI_KOR_TRAVEL_MAP_CACHE_TARGET_EXPECTED_OPENAPI_SHA256=
PINVI_KOR_TRAVEL_MAP_CACHE_TARGET_EXPECTED_SOURCE_REVISION=
PINVI_KOR_TRAVEL_MAP_CACHE_TARGET_EXPECTED_CONTRACT_GENERATION=
# M05 paired reconciliation은 signed production activation receipt와 live 증거 전까지 false를 유지한다.
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_ENABLED=false
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_READ_TOKEN=
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_ACK_TOKEN=
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_POLL_SECONDS=1
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_BLOCKED_RECHECK_SECONDS=30
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_EXPECTED_OPENAPI_SHA256=
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_EXPECTED_SOURCE_REVISION=
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_ACTIVATION_RECEIPT=
# container ID 결박을 유지하기 위해 receipt는 deploy 전 root-owned 0600 파일로 봉인하고 read-only mount한다.
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_ACTIVATION_RECEIPT_PATH=/run/pinvi/m05/activation-receipt.json
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_ACTIVATION_RECEIPT_HOST_PATH=/srv/pinvi/m05/activation-receipt.json
# receipt 서명을 검증하는 Ed25519 public key(raw 32-byte base64url). tracked trust anchor fingerprint와 대조한다.
PINVI_KOR_TRAVEL_MAP_FEATURE_REFERENCE_RECONCILIATION_ACTIVATION_RECEIPT_PUBLIC_KEY=
# deploy 전 root-owned append-only ledger를 API container에 read-only mount하고 경로를 지정한다.
PINVI_M05_ACTIVATION_LEDGER_PATH=/run/pinvi/m05/activation-ledger.jsonl
PINVI_M05_ACTIVATION_LEDGER_HOST_PATH=/srv/pinvi/m05/activation-ledger.jsonl
# ordinary API는 raw dump가 아닌 metadata-only catalog만 읽는다.
PINVI_BACKUP_DIR=/var/lib/pinvi/backup-catalog
PINVI_BACKUP_CATALOG_HOST_DIR=/srv/pinvi/backup-catalog
PINVI_M05_ACTIVATION_HIGH_WATERMARK_PATH=/run/pinvi/m05/activation-high-watermark.json
PINVI_M05_ACTIVATION_HIGH_WATERMARK_HOST_PATH=/srv/pinvi/m05/activation-high-watermark.json
PINVI_M05_ACTIVATION_DURABLE_FLOOR_PATH=/run/pinvi/m05/activation-durable-floor.json
PINVI_M05_ACTIVATION_DURABLE_FLOOR_HOST_PATH=/srv/pinvi/m05/activation-durable-floor.json
PINVI_M05_ACTIVATION_DURABLE_HISTORY_PATH=/run/pinvi/m05/activation-durable-history.jsonl
PINVI_M05_ACTIVATION_DURABLE_HISTORY_HOST_PATH=/srv/pinvi/m05/activation-durable-history.jsonl
PINVI_M05_ACTIVATION_DURABLE_ANCHOR_PATH=/run/pinvi/m05/activation-durable-anchor.jsonl
PINVI_M05_ACTIVATION_DURABLE_ANCHOR_HOST_PATH=/srv/pinvi/m05-anchor/activation-durable-anchor.jsonl
# exact API/Web/Dagster/Map runtime identity를 receipt에 묶은 root-owned 0600 attestation.
PINVI_M05_RUNTIME_ATTESTATION_PATH=/run/pinvi/m05/runtime-attestation.json
PINVI_M05_RUNTIME_ATTESTATION_HOST_PATH=/srv/pinvi/m05/runtime-attestation.json
# root watcher가 atomic rename하는 public trust/current lease directory. API에는 이 directory만 read-only bind한다.
PINVI_M05_RUNTIME_LEASE_DIRECTORY=/run/pinvi/m05/lease
PINVI_M05_RUNTIME_LEASE_HOST_DIR=/srv/pinvi/m05/lease
PINVI_M05_RUNTIME_LEASE_MAX_LIFETIME_SECONDS=120
# M05 startup live dependency check는 host watcher에서만 이 local Unix socket을 사용한다. 원격 Docker daemon은 금지한다.
PINVI_DOCKER_SOCKET_PATH=/var/run/docker.sock
PINVI_M05_ACTIVATION_PR_URL=https://github.com/digitie/pinvi/pull/466
# 배포자가 승인한 마지막 ledger generation. receipt 재생/rollback 방지용 high-watermark.
PINVI_M05_ACTIVATION_MIN_GENERATION=1
# deploy-node/docker-app의 one-shot migrator password rotation을 단일 host에서 직렬화한다.
# staging/production은 이 파일과 parent를 root-owned로 만들고 mode 0600/비쓰기 가능으로 유지한다.
PINVI_MIGRATOR_LIFECYCLE_LOCK_PATH=/var/lib/pinvi/restore-forensics/migrator-lifecycle.lock
PINVI_RESTORE_DRAIN_VERIFIED=false
# schema-swap 유지보수 주체가 target DB owner URL을 별도 주입할 때만 사용한다. ordinary API 기본값은 빈 값.
PINVI_RESTORE_FENCE_DATABASE_URL=
# fresh target 생성용 root-only maintenance role은 one-shot drill host에서만 주입한다.
PINVI_RESTORE_PROVISIONER_ROLE=
# root-only one-shot producer/restore runner만 쓰는 trusted snapshot 경로. app-api에는 mount하지 않는다.
PINVI_RESTORE_TRUSTED_BACKUP_HOST_DIR=/srv/pinvi/restore-trust
# deploy 시 canonical scripts/restore-hotswap.sh SHA-256을 계산해 주입한다.
PINVI_RESTORE_HOTSWAP_SCRIPT_SHA256=
# deploy wrapper가 OCI label/image ID 대조 뒤 주입한다. raw compose 경로는 비워 fail-close한다.
PINVI_API_IMAGE_DIGEST=
PINVI_WEB_IMAGE_DIGEST=
PINVI_DAGSTER_IMAGE_DIGEST=
PINVI_KOR_TRAVEL_MAP_CURATION_SNAPSHOT_TOKEN=
PINVI_KOR_TRAVEL_MAP_CURATION_CUTOVER_MAPPING_TOKEN=
# restore/recovery token은 ordinary API container가 아니라 전용 job secret으로만 주입한다.
# ADR-035: Trip WebSocket broker는 process-local in-memory다. shared broker 전환 전까지 1 유지.
PINVI_API_WORKERS=1
PINVI_GRAFANA_PORT=12205
PINVI_GRAFANA_ADMIN_USER=admin
PINVI_GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# ── 한국 전용 geofencing (ADR-018) ──────────────────────────────────────
# 운영 edge(Cloudflare/nginx/HAProxy)가 CF-IPCountry와 trusted proxy signal을 API로 전달할 때만
# true로 전환한다. PINVI_GEOFENCE_BLOCK_UNKNOWN=true는 trusted signal 누락 트래픽을 451로
# 차단하므로, edge header 주입을 먼저 검증한다.
PINVI_GEOFENCE_ENABLED=false
PINVI_GEOFENCE_ALLOWED_COUNTRIES=["KR"]
PINVI_GEOFENCE_COUNTRY_HEADER=CF-IPCountry
PINVI_GEOFENCE_TRUSTED_PROXY_HEADER=X-Pinvi-Geofence-Proxy
PINVI_GEOFENCE_TRUSTED_PROXY_SECRET=
PINVI_GEOFENCE_TRUSTED_PROXY_CIDRS=[]
PINVI_GEOFENCE_MTLS_VERIFIED_HEADER=
PINVI_GEOFENCE_MTLS_VERIFIED_VALUE=SUCCESS
PINVI_GEOFENCE_BLOCK_UNKNOWN=false
PINVI_GEOFENCE_BYPASS_PATHS=["/health","/health/db","/metrics","/docs","/redoc","/openapi.json"]

# ── 이미지 tag (deploy.md §1·§2) ─────────────────────────────────────────
# 운영 노드에서 ktdctl이 ~/pinvi 소스로 로컬 빌드한다(GHCR 미사용). kor-travel-* 스택과 동일.
PINVI_API_IMAGE=pinvi-api:latest-main
PINVI_WEB_IMAGE=pinvi-web:latest-main
PINVI_DAGSTER_IMAGE=pinvi-dagster:latest-main
# PINVI_SOURCE_REVISION은 파일에 고정하지 않는다. production build wrapper/ktdctl이 clean
# PinVi source HEAD에서 계산해 Docker build arg로 전달하고 image OCI label과 대조한다.

# ── 시크릿 — 운영 실제 값으로 채울 것(예시 값 금지) ──────────────────────
PINVI_DB_OWNER_USER=pinvi_owner
PINVI_POSTGRES_PASSWORD=change-me
PINVI_APP_DB_USER=pinvi_app
PINVI_APP_DB_PASSWORD=change-me
PINVI_APP_SCHEMA_OWNER=pinvi_app_owner
PINVI_MIGRATION_OWNER=pinvi_migration_owner
PINVI_MIGRATOR_DB_USER=pinvi_migrator
PINVI_MIGRATOR_DB_PASSWORD=change-me
# 평상시 0. legacy 전환 때도 파일을 1로 고정하지 말고 해당 one-shot 명령에만 export한다.
PINVI_M05_LEGACY_REBASELINE=0
# ordinary API/Dagster only — this role is non-superuser and never owns app objects.
PINVI_DATABASE_URL=postgresql+asyncpg://pinvi_app:change-me@app-postgres:5432/pinvi
# 0061 root-only profile 전용. 일반 app-migrator/API/Dagster에는 절대 전달하지 않는다.
PINVI_LEGACY_REBASELINE_DATABASE_URL=
# 같은 one-shot에만 지정하는 root-owned 0600 applied rebaseline receipt의 host 절대경로.
PINVI_M05_LEGACY_REBASELINE_RECEIPT_HOST_PATH=
PINVI_JWT_SECRET_KEY=change-me-32-bytes-minimum-secret
PINVI_MCP_JWT_SECRET=change-me-32-bytes-minimum-secret
# admin bootstrap은 ordinary API env가 아니라 `pinvi-admin-bootstrap` one-shot의
# owner-only 0600 JSON credential file mount로만 수행한다.
PINVI_RESEND_API_KEY=
# 서버 VWorld key. 모바일 `/mobile/vworld/token` 발급과 kor-travel-geo v2 REST `key`
# query에 같은 값을 사용한다(ADR-048). kor-travel-geo 쪽 `KTG_VWORLD_API_KEY`도 같은
# 값으로 설정하고, 그 서비스가 공개 API key hash 저장/검증을 소유한다.
PINVI_VWORLD_API_KEY=
NEXT_PUBLIC_VWORLD_API_KEY=
DATA_GO_KR_SERVICE_KEY=
