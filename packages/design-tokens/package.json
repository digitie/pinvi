{
  "name": "@pinvi/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Pinvi 디자인 토큰 — Airbnb 톤 + 16색 마커 팔레트 + Tailwind preset",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tailwind-preset": "./tailwind-preset.cjs",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:theme": "node scripts/build-theme.mjs",
    "check:theme": "node scripts/build-theme.mjs --check"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
