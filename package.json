{
  "name": "pinvi",
  "private": true,
  "version": "0.1.0",
  "description": "Pinvi v2 — 한국 여행 계획·기록·공유 애플리케이션",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "docker:app:build": "bash scripts/docker-app.sh build",
    "docker:app:up": "bash scripts/docker-app.sh up",
    "docker:app:down": "bash scripts/docker-app.sh down",
    "docker:app:status": "bash scripts/docker-app.sh status",
    "docker:app:smoke": "bash scripts/docker-app.sh smoke",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:lockfile": "node scripts/check-lockfile-integrity.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md}\""
  },
  "overrides": {
    "sharp@^0.34.3": "0.35.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-babel-transformer": "0.88.1",
    "@types/react": "19.3.0",
    "decode-uri-component": "0.5.1",
    "postcss-selector-parser": "7.1.6",
    "@expo/cli": {
      "zod": "4.6.7"
    },
    "shell-quote": "1.12.0",
    "postcss": "8.5.32",
    "lightningcss": "$lightningcss",
    "@types/react-dom": "19.3.0",
    "vworld-map-core": "$vworld-map-core",
    "eslint": "$eslint",
    "@radix-ui/react-focus-scope": "$@radix-ui/react-focus-scope"
  },
  "dependencies": {
    "expo": "58.0.24",
    "expo-router": "58.0.31",
    "vworld-map-core": "file:apps/web/vendor/vworld-map-core-1.0.1.tgz",
    "@radix-ui/react-focus-scope": "file:apps/web/vendor/radix-ui-react-focus-scope-1.3.1+kortravel.fix.2.tgz"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "lightningcss": "file:apps/web/vendor/lightningcss-1.33.0+nativecss.fix.4.tgz",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "22.23.1",
    "npm": "12.0.1"
  },
  "packageManager": "npm@12.0.1"
}
