{
  "name": "pinvi",
  "private": true,
  "version": "0.1.0",
  "description": "Pinvi v2 — 한국 여행 계획·기록·공유 애플리케이션",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "dev:up": "bash scripts/dev-up.sh",
    "dev:down": "bash scripts/dev-down.sh",
    "docker:app:build": "bash scripts/docker-app.sh build",
    "docker:app:up": "bash scripts/docker-app.sh up",
    "docker:app:down": "bash scripts/docker-app.sh down",
    "docker:app:status": "bash scripts/docker-app.sh status",
    "docker:app:smoke": "bash scripts/docker-app.sh smoke",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:lockfile": "node scripts/check-lockfile-integrity.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md}\""
  },
  "overrides": {
    "postcss@8.4.31": "8.5.31",
    "sharp@^0.34.3": "0.35.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "@react-native/metro-config": "0.86.3",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-babel-transformer": "0.86.3",
    "@types/react": "19.2.18",
    "decode-uri-component": "0.5.1",
    "postcss-selector-parser": "7.1.6",
    "@expo/cli": {
      "zod": "4.6.7"
    },
    "shell-quote": "1.12.0"
  },
  "dependencies": {
    "expo": "57.0.31"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": "12.0.1"
  },
  "packageManager": "npm@12.0.1"
}
